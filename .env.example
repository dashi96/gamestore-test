# Копировать не обязательно: без .env всё поднимается на значениях по умолчанию,
# они прописаны в docker-compose.yml. Файл нужен, только если хочется покрутить
# поведение — например, сделать поставщиков злее перед демонстрацией сбоев.
#
#   cp .env.example .env && docker compose up

# ── Доступ ────────────────────────────────────────────────────────────────
# Токен админки: Authorization: Bearer <token>. Он же подставлен в поле
# «Токен» на странице admin.html.
ADMIN_TOKEN=admin-token

# ── Выдача ────────────────────────────────────────────────────────────────
# Через сколько миллисекунд считаем, что ответ поставщика не дошёл.
# Таймаут не равен отказу: повтор уходит к тому же поставщику с тем же
# request_id, поэтому уменьшение этого значения не приводит к двойной выдаче,
# а только к более частым повторам.
PROVIDER_TIMEOUT_MS=2000

# Сколько раз дёргаем поставщика при неоднозначном исходе (таймаут, 5xx),
# прежде чем перевести заказ в восстановимое delivery_failed. Повторы после
# этого не прекращаются, только разреживаются.
MAX_DELIVERY_ATTEMPTS=5

# ── Характер заглушек-поставщиков ─────────────────────────────────────────
# Доли от 0 до 1. Значения по умолчанию имитируют капризную, но рабочую
# интеграцию. Те же параметры меняются на лету из админки и из сценариев
# проверки гонок, так что для разовых опытов править файл не нужно.
A_ERROR_RATE=0.15
A_TIMEOUT_RATE=0.1
B_ERROR_RATE=0.15
B_TIMEOUT_RATE=0.1

# Задержка ответа поставщика и то, как долго он «висит», прежде чем всё-таки
# закрыть соединение. Второе значение должно быть заметно больше
# PROVIDER_TIMEOUT_MS, иначе зависание не успеет воспроизвестись.
PROVIDER_LATENCY_MS=50
PROVIDER_MAX_HANG_MS=60000

# ── Логи ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
